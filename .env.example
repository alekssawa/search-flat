# Telegram Bot credentials
BOT_TOKEN=your_telegram_bot_token_here
TARGET_CHAT_ID=your_telegram_chat_id_here

# Polling interval in minutes (default: 15)
POLL_INTERVAL_MINUTES=15

# Upon initial launch, mark current existing ads as seen without sending to chat (true/false)
INITIAL_SKIP_EXISTING=true

# 999.md headers (optional / from browser)
ACCESS_TOKEN=
AUTH_HEADER=
